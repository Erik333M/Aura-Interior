# ─── API ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Prisma. SQLite for local dev; swap to a postgresql:// URL for production
# (the schema is written to be Postgres-portable — see prisma/schema.prisma).
# Prisma 7 resolves relative SQLite paths against the process cwd (apps/api),
# NOT the schema directory. This lands the file at apps/api/prisma/aura.db.
DATABASE_URL="file:./prisma/aura.db"

# Auth — generate a real secret: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded admin. Never hardcode these in source.
ADMIN_EMAIL=admin@aurainterior.am
ADMIN_PASSWORD=change-me-before-first-run

# Inquiry notification email (nodemailer). Leave SMTP_HOST empty to
# log inquiries to the console instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aura Interior <no-reply@aurainterior.am>"
MAIL_TO=orders@aurainterior.am

# ─── WEB (Vite — only VITE_* is exposed to the browser) ───────────────
VITE_API_URL=http://localhost:4000
VITE_WHATSAPP_NUMBER=37400000000
VITE_INSTAGRAM_HANDLE=aura_Interior
